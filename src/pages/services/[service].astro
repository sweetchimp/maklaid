---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/design-system/Card.astro';
import Badge from '../../components/design-system/Badge.astro';
import CtaSection from '../../components/CtaSection.astro';
import Faq from '../../components/Faq.astro';
import { ArrowRight, Check, Phone, Mail } from 'lucide-react';
import { services } from '../../data/services';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

interface Props {
  service: (typeof services)[number];
}

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;
const related = services.filter((item) => item.slug !== service.slug).slice(0, 3);
---

<PageLayout
  title={`${service.title} | MAKLAID`}
  eyebrow={service.tag}
  description={service.overview[0]}
  path={`/services/${service.slug}`}
  keywords={`${service.title}, ${service.tag.toLowerCase()}, kenya, nairobi, maklaid`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema(service))} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([
      { label: 'Home', path: '/' },
      { label: 'Services', path: '/services' },
      { label: service.title, path: `/services/${service.slug}` },
    ]))} />
  </Fragment>
  <div slot="lede">
    <p class="font-body text-body leading-relaxed text-neutral-500">{service.overview[0]}</p>
  </div>

  <div class="flex flex-col gap-xl">
    <section class="max-w-3xl">
      <h2 class="font-heading text-h3 font-semibold text-navy-900">Overview</h2>
      <p class="mt-sm font-body text-body leading-relaxed text-neutral-500">{service.overview[1]}</p>
    </section>

    <section>
      <h2 class="font-heading text-h3 font-semibold text-navy-900">How We Work</h2>
      <ol class="mt-md grid gap-md sm:grid-cols-2 lg:grid-cols-4">
        {
          service.process.map((step, index) => (
            <li class="flex h-full flex-col gap-xs rounded-xl border border-neutral-200 bg-white p-md shadow-sm">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-navy-900 font-heading text-small font-bold text-gold-500">
                {index + 1}
              </span>
              <h3 class="font-heading text-body font-semibold text-navy-900">{step.title}</h3>
              <p class="font-body text-small leading-relaxed text-neutral-500">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="max-w-3xl">
      <h2 class="font-heading text-h3 font-semibold text-navy-900">Typical Outcomes</h2>
      <ul class="mt-md grid gap-sm sm:grid-cols-2">
        {
          service.outcomes.map((outcome) => (
            <li class="flex items-start gap-xs font-body text-body leading-relaxed text-neutral-500">
              <span class="mt-1 shrink-0 text-success"><Check size={18} /></span>
              {outcome}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="max-w-3xl">
      <h2 class="font-heading text-h3 font-semibold text-navy-900">Frequently Asked Questions</h2>
      <div class="mt-md">
        <Faq items={service.faq} />
      </div>
    </section>

    <section>
      <h2 class="font-heading text-h3 font-semibold text-navy-900">Related Practice Areas</h2>
      <div class="mt-md grid gap-md sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((item) => (
            <a
              href={`/services/${item.slug}`}
              class="group block h-full rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
            >
              <Card variant="interactive" bordered class="h-full">
                <Badge variant="navy" size="sm">{item.tag}</Badge>
                <h3 class="mt-xs font-heading text-body font-semibold text-navy-900">{item.title}</h3>
                <p class="mt-xs font-body text-small leading-relaxed text-neutral-500">{item.description}</p>
                <span class="mt-auto inline-flex items-center gap-1 pt-sm font-body text-small font-semibold text-gold-600 transition-colors duration-200 group-hover:text-gold-500">
                  Learn more
                  <ArrowRight
                    size={16}
                    className="transition-transform duration-200 group-hover:translate-x-0.5"
                  />
                </span>
              </Card>
            </a>
          ))
        }
      </div>
    </section>

    <section class="rounded-xl border border-neutral-200 bg-neutral-50 p-md">
      <CtaSection
        variant="navy"
        headline={`Discuss your ${service.title.toLowerCase()} matter`}
        subtext="Your first consultation is free."
        label="Schedule Consultation"
        href="/contact"
      />
      <div class="mx-auto mt-md flex max-w-7xl flex-wrap items-center justify-center gap-md px-sm md:px-lg">
        <a href="tel:+254700000000" class="inline-flex items-center gap-xs font-body text-small font-medium text-navy-100 hover:text-gold-400">
          <Phone size={16} /> +254 (0) 700 000 000
        </a>
        <a href="mailto:info@maklaid.co.ke" class="inline-flex items-center gap-xs font-body text-small font-medium text-navy-100 hover:text-gold-400">
          <Mail size={16} /> info@maklaid.co.ke
        </a>
      </div>
    </section>
  </div>
</PageLayout>
