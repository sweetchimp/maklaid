---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card, Badge, Logo } from '../components/design-system/index.ts';
import { theme, type ShadeKey } from '../lib/theme';

interface Props {}

const navy = Object.entries(theme.colors.primary.scale) as [ShadeKey, string][];
const gold = Object.entries(theme.colors.secondary.scale) as [ShadeKey, string][];

const neutralSwatches = [
  { name: 'text', value: theme.colors.neutral.text },
  { name: 'surface', value: theme.colors.neutral.surface },
  { name: 'white', value: theme.colors.neutral.white },
  { name: 'border', value: theme.colors.neutral.border },
  { name: 'muted', value: theme.colors.neutral.muted },
];

const statusSwatches = [
  { name: 'success', value: theme.colors.status.success, text: 'text-success-700' },
  { name: 'warning', value: theme.colors.status.warning, text: 'text-warning-700' },
  { name: 'error', value: theme.colors.status.error, text: 'text-error-700' },
];

const buttonVariants = ['primary', 'secondary', 'ghost'] as const;
const buttonSizes = ['sm', 'md', 'lg'] as const;
const badgeVariants = ['navy', 'gold', 'success', 'warning', 'error', 'neutral'] as const;

const sectionClass = 'mx-auto max-w-7xl px-sm py-xl md:px-lg';
const eyebrowClass =
  'font-body text-small font-semibold tracking-widest uppercase text-gold-600';
---

<BaseLayout title="Design System | MAKLAID" description="MAKLAID design system reference." path="/design-system">
  <!-- Intro -->
  <section class="bg-navy-900 py-lg text-white">
    <div class={sectionClass}>
      <p class={eyebrowClass}>MAKLAID</p>
      <h1 class="mt-xs font-heading text-h2 font-bold md:text-h1">Design System</h1>
      <p class="mt-sm max-w-2xl font-body text-body text-navy-100">
        Tokens and components for the MAKLAID web experience. Brand navy is sampled directly from
        the official logo; every component below is responsive and typed.
      </p>
    </div>
  </section>

  <!-- Colors -->
  <section id="colors" class="bg-white">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Colors</h2>

      <h3 class="mt-lg font-heading text-h3 font-semibold text-neutral-800">
        Primary — Navy <span class="font-body text-small font-normal text-neutral-500">(#152137 exact logo color)</span>
      </h3>
      <div class="mt-sm grid grid-cols-2 gap-sm sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-11">
        {
          navy.map(([shade, hex]) => (
            <figure class="overflow-hidden rounded-lg border border-neutral-200">
              <div class="h-16 w-full" style={`background-color:${hex}`} />
              <figcaption class="p-2 font-body text-[0.6875rem] leading-tight">
                <span class="block font-semibold">{`navy-${shade}`}</span>
                <span class="block text-neutral-500 uppercase">{hex}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h3 class="mt-lg font-heading text-h3 font-semibold text-neutral-800">
        Secondary — Gold <span class="font-body text-small font-normal text-neutral-500">(brand accent)</span>
      </h3>
      <div class="mt-sm grid grid-cols-2 gap-sm sm:grid-cols-4 lg:grid-cols-6 xl:grid-cols-11">
        {
          gold.map(([shade, hex]) => (
            <figure class="overflow-hidden rounded-lg border border-neutral-200">
              <div class="h-16 w-full" style={`background-color:${hex}`} />
              <figcaption class="p-2 font-body text-[0.6875rem] leading-tight">
                <span class="block font-semibold">{`gold-${shade}`}</span>
                <span class="block text-neutral-500 uppercase">{hex}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h3 class="mt-lg font-heading text-h3 font-semibold text-neutral-800">Neutrals &amp; Status</h3>
      <div class="mt-sm flex flex-wrap gap-sm">
        {
          neutralSwatches.map(({ name, value }) => (
            <figure class="w-36 overflow-hidden rounded-lg border border-neutral-200">
              <div
                class="h-16 w-full"
                style={`background-color:${value}`}
                class:list={name === 'white' ? '' : ''}
              />
              <figcaption class="p-2 font-body text-[0.6875rem] leading-tight">
                <span class="block font-semibold capitalize">{name}</span>
                <span class="block text-neutral-500 uppercase">{value}</span>
              </figcaption>
            </figure>
          ))
        }
        {
          statusSwatches.map(({ name, value }) => (
            <figure class="w-36 overflow-hidden rounded-lg border border-neutral-200">
              <div class="h-16 w-full" style={`background-color:${value}`} />
              <figcaption class="p-2 font-body text-[0.6875rem] leading-tight">
                <span class="block font-semibold capitalize">{name}</span>
                <span class="block text-neutral-500 uppercase">{value}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Typography -->
  <section id="typography" class="bg-neutral-50">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Typography</h2>
      <p class="mt-xs max-w-2xl font-body text-body text-neutral-500">
        Headings use <strong>Playfair Display</strong> (serif, authority); body uses
        <strong>Inter</strong> (sans-serif, readability).
      </p>

      <div class="mt-lg flex flex-col divide-y divide-neutral-200 rounded-xl bg-white p-md shadow-sm">
        <div class="flex flex-col items-baseline justify-between gap-xs pb-md md:flex-row">
          <span class="font-body text-small text-neutral-400">h1 · 3.5rem · Playfair Display</span>
          <span class="font-heading text-h1 font-bold text-navy-900">Justice, delivered.</span>
        </div>
        <div class="flex flex-col items-baseline justify-between gap-xs py-md md:flex-row">
          <span class="font-body text-small text-neutral-400">h2 · 2.5rem</span>
          <span class="font-heading text-h2 font-bold text-navy-900">Practice Areas</span>
        </div>
        <div class="flex flex-col items-baseline justify-between gap-xs py-md md:flex-row">
          <span class="font-body text-small text-neutral-400">h3 · 2rem</span>
          <span class="font-heading text-h3 font-semibold text-navy-900">Corporate Law</span>
        </div>
        <div class="flex flex-col items-baseline justify-between gap-xs py-md md:flex-row">
          <span class="font-body text-small text-neutral-400">body · 1rem · Inter</span>
          <p class="max-w-xl font-body text-body text-neutral-800">
            MAKLAID provides clear counsel and decisive representation across every area of law.
          </p>
        </div>
        <div class="flex flex-col items-baseline justify-between gap-xs pt-md md:flex-row">
          <span class="font-body text-small text-neutral-400">small · 0.875rem</span>
          <span class="font-body text-small text-neutral-500">
            Advocates · Commissioners for Oaths · Notaries Public
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Spacing -->
  <section id="spacing" class="bg-white">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Spacing</h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Named tokens on Tailwind's 4px base unit — usable in any spacing utility
        (<code>p-md</code>, <code>gap-sm</code>, <code>py-xl</code>…).
      </p>
      <ul class="mt-lg flex flex-col gap-sm">
        {
          Object.entries(theme.spacing).map(([token, value]) => (
            <li class="flex items-center gap-md">
              <span class="w-24 shrink-0 font-body text-small font-semibold text-neutral-800">
                {token}
              </span>
              <span class="w-20 shrink-0 font-mono text-small text-neutral-500">{value}</span>
              <span
                class="inline-block h-6 rounded bg-navy-200"
                style={`width:${value}`}
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Buttons -->
  <section id="buttons" class="bg-neutral-50">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Buttons</h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Three variants × three sizes. All include hover-scale, focus rings and disabled states.
      </p>

      <Card bordered class="mt-lg overflow-x-auto">
        <table class="w-full min-w-[36rem] text-left">
          <thead>
            <tr class="border-b border-neutral-200">
              <th class="pb-sm font-body text-small font-semibold text-neutral-500">Variant</th>
              <th class="pb-sm font-body text-small font-semibold text-neutral-500">sm</th>
              <th class="pb-sm font-body text-small font-semibold text-neutral-500">md</th>
              <th class="pb-sm font-body text-small font-semibold text-neutral-500">lg</th>
              <th class="pb-sm font-body text-small font-semibold text-neutral-500">disabled</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            {
              buttonVariants.map((variant) => (
                <tr>
                  <td class="py-sm pr-md font-body text-small font-semibold capitalize">
                    {variant}
                  </td>
                  {buttonSizes.map((size) => (
                    <td class="py-sm pr-md">
                      <Button variant={variant} size={size}>
                        Label
                      </Button>
                    </td>
                  ))}
                  <td class="py-sm">
                    <Button variant={variant} size="md" disabled>
                      Label
                    </Button>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Card>
    </div>
  </section>

  <!-- Cards -->
  <section id="cards" class="bg-white">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Cards</h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Default, bordered and interactive variants.
      </p>
      <div class="mt-lg grid gap-md sm:grid-cols-2 lg:grid-cols-3">
        <Card>
          <Badge variant="navy" size="sm">Default</Badge>
          <h3 class="font-heading text-h3 font-semibold text-navy-900">Clean surface</h3>
          <p class="font-body text-small leading-relaxed text-neutral-500">
            Soft shadow on a white background — the workhorse content container.
          </p>
        </Card>
        <Card bordered>
          <Badge variant="neutral" size="sm">Bordered</Badge>
          <h3 class="font-heading text-h3 font-semibold text-navy-900">Defined edge</h3>
          <p class="font-body text-small leading-relaxed text-neutral-500">
            Adds a subtle border for layouts that need stronger separation.
          </p>
        </Card>
        <Card variant="interactive" bordered>
          <Badge variant="gold" size="sm">Interactive</Badge>
          <h3 class="font-heading text-h3 font-semibold text-navy-900">Hover me</h3>
          <p class="font-body text-small leading-relaxed text-neutral-500">
            Lifts and scales on hover — ideal for clickable practice-area or article cards.
          </p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Badges -->
  <section id="badges" class="bg-neutral-50">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Badges</h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        For practice areas, status tags and eyebrows.
      </p>
      <div class="mt-lg flex flex-wrap items-center gap-sm rounded-xl bg-white p-md shadow-sm">
        {badgeVariants.map((variant) => <Badge variant={variant}>Case {variant}</Badge>)}
      </div>
    </div>
  </section>

  <!-- Animations + Logo -->
  <section id="animations" class="bg-white">
    <div class={sectionClass}>
      <h2 class="font-heading text-h2 font-bold text-navy-900">Motion &amp; Brand</h2>

      <div class="mt-lg grid gap-md lg:grid-cols-2">
        <div class="flex flex-col gap-md">
          <div class="animate-fade-in rounded-lg bg-navy-900 p-md text-white">
            <p class="font-body text-small font-semibold tracking-wide uppercase opacity-70">
              animate-fade-in
            </p>
            <p class="font-heading text-h3 font-semibold">opacity 0 → 1 · 300ms</p>
          </div>
          <div class="animate-slide-up rounded-lg bg-gold-500 p-md text-navy-950">
            <p class="font-body text-small font-semibold tracking-wide uppercase opacity-80">
              animate-slide-up
            </p>
            <p class="font-heading text-h3 font-semibold">translateY 20px → 0 · 400ms</p>
          </div>
          <div class="hover-scale w-fit cursor-pointer rounded-lg bg-navy-100 p-md text-navy-900">
            <p class="font-body text-small font-semibold tracking-wide uppercase text-neutral-500">
              hover-scale
            </p>
            <p class="font-heading text-h3 font-semibold">scale 1 → 1.05 · 200ms</p>
          </div>
        </div>

        <Card bordered class="items-center justify-center">
          <p class="font-body text-small font-semibold tracking-wide uppercase text-neutral-400">
            Logo — used as-is on brand navy
          </p>
          <div class="mt-md flex w-full items-center justify-center rounded-lg bg-navy-900 p-lg">
            <Logo class="w-56" alt="MAKLAID logo" />
          </div>
          <p class="font-body text-small text-neutral-500">
            The watermark version sits at 5% opacity on every page (bottom-right).
          </p>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
