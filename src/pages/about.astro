---
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/design-system/Card.astro';
import Button from '../components/design-system/Button.astro';
import Badge from '../components/design-system/Badge.astro';
import CtaSection from '../components/CtaSection.astro';
import { Scale, ShieldCheck, HeartHandshake } from 'lucide-react';
import { team } from '../data/team';
import { firmInfo } from '../data/firm';

interface Props {}

const values = [
  {
    Icon: ShieldCheck,
    title: firmInfo.values[1].title,
    description: firmInfo.values[1].description,
  },
  {
    Icon: Scale,
    title: firmInfo.values[2].title,
    description: firmInfo.values[2].description,
  },
  {
    Icon: HeartHandshake,
    title: firmInfo.values[0].title,
    description: firmInfo.values[0].description,
  },
];

const milestones = [
  { year: '2024', text: 'MAKLAID ADVOCATES founded in Kampala, Uganda — a new era of expert legal counsel for East Africa.' },
  { year: '2024', text: 'Corporate, property, litigation, family and criminal law practices established from day one.' },
  { year: '2025', text: 'Expanding our client base across Uganda and the East African region.' },
];
---

<PageLayout
  title="About MAKLAID ADVOCATES"
  eyebrow="Our Firm"
  description="The story, values and people behind MAKLAID ADVOCATES — a dynamic Ugandan law firm built on respect, integrity and leadership."
  path="/about"
  keywords="about maklaid advocates, law firm history, kampala law firm, ugandan lawyers, legal team uganda"
>
  <div slot="lede">
    <p class="font-body text-body leading-relaxed text-neutral-500">
      A firm built on a simple conviction: excellent legal counsel should be rigorous, responsive
      and human.
    </p>
  </div>

  <section class="max-w-3xl">
    <h2 class="font-heading text-h3 font-semibold text-navy-900">Our Story</h2>
    <p class="mt-sm font-body text-body leading-relaxed text-neutral-500">
      {firmInfo.fullAbout}
    </p>
    <p class="mt-sm font-body text-body leading-relaxed text-neutral-500">
      From multinational corporations to families navigating life's hardest moments, we
      measure ourselves by one standard — outcomes our clients can build on. Our diverse
      client base ranges from individuals and small businesses to large corporations and
      organizations across Uganda and the East African region.
    </p>
  </section>

  <section class="mt-xl">
    <h2 class="font-heading text-h3 font-semibold text-navy-900">Core Values</h2>
    <div class="mt-md grid gap-md sm:grid-cols-2 lg:grid-cols-3">
      {
        values.map(({ Icon, title, description }) => (
          <Card bordered>
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gold-100 text-gold-700">
              <Icon size={24} />
            </span>
            <h3 class="mt-sm font-heading text-body font-semibold text-navy-900">{title}</h3>
            <p class="mt-xs font-body text-small leading-relaxed text-neutral-500">{description}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="mt-xl">
    <div class="flex flex-wrap items-end justify-between gap-sm">
      <h2 class="font-heading text-h3 font-semibold text-navy-900">Our Team</h2>
      <Button href="/team" variant="ghost" size="sm">Meet the Full Team</Button>
    </div>
    <div class="mt-md grid gap-md sm:grid-cols-2 lg:grid-cols-3">
      {
        team.map((member) => (
          <a
            href={`/team/${member.slug}`}
            class="group flex items-center gap-md rounded-xl border border-neutral-200 bg-white p-sm shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
          >
            <img
              src={member.photo}
              alt={`Portrait of ${member.name}`}
              width="480"
              height="600"
              loading="lazy"
              class="h-16 w-16 shrink-0 rounded-full object-cover"
            />
            <div>
              <h3 class="font-heading text-body font-semibold text-navy-900">{member.name}</h3>
              <p class="font-body text-small text-neutral-500">{member.title}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-xl">
    <h2 class="font-heading text-h3 font-semibold text-navy-900">Milestones</h2>
    <ol class="mt-md flex flex-col gap-xs border-l-2 border-navy-100 pl-lg">
      {
        milestones.map(({ year, text }) => (
          <li class="relative">
            <span class="absolute -left-[calc(2rem+7px)] top-1 h-3.5 w-3.5 rounded-full border-2 border-gold-500 bg-white" />
            <Badge variant="gold" size="sm">{year}</Badge>
            <p class="mt-xs font-body text-body leading-relaxed text-neutral-500">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="mt-xl">
    <CtaSection variant="navy" headline="Ready to work with us?" subtext="Your first consultation is free." label="Schedule Consultation" href="/contact" />
  </div>
</PageLayout>
