---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import HomeAbout from '../components/HomeAbout.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeWhy from '../components/HomeWhy.astro';
import HomeTeam from '../components/HomeTeam.astro';
import HomeInsights from '../components/HomeInsights.astro';
import CtaSection from '../components/CtaSection.astro';
import HomeContact from '../components/HomeContact.astro';

interface Props {}
---

<PageLayout
  bare
  title="MAKLAID | Law Firm"
  description="MAKLAID is a full-service law firm delivering trusted counsel and results-driven representation across corporate, family, criminal and property matters."
  path="/"
  keywords="law firm, kenya, nairobi, legal services, corporate law, family law, criminal defense, real estate, immigration, litigation"
>
  <Hero />
  <HomeAbout />
  <HomeServices />
  <HomeWhy />
  <HomeTeam />
  <HomeInsights />
  <CtaSection
    variant="navy"
    headline="Ready to discuss your legal needs?"
    subtext="Book a free, no-obligation consultation with our advocates."
    label="Schedule Consultation"
    href="/contact"
  />
  <HomeContact />
</PageLayout>
