---
import Button from './design-system/Button.astro';
import { X } from 'lucide-react';
import { navLinks } from '../lib/theme';

interface Props {}

const path = (Astro.url.pathname.replace(/\/+$/, '') || '/').toLowerCase();

const isActive = (href: string): boolean => {
  const clean = href.replace(/\/+$/, '').toLowerCase();
  if (clean === '' || clean === '/') return path === '/';
  return path === clean || path.startsWith(`${clean}/`);
};
---

<!-- Backdrop -->
<div
  id="menu-backdrop"
  class="backdrop fixed inset-0 z-[60] bg-backdrop"
  aria-hidden="true"
>
</div>

<!-- Sliding drawer -->
<aside
  id="mobile-drawer"
  class="drawer fixed inset-y-0 right-0 z-[70] flex w-72 max-w-[85vw] flex-col bg-navy-950 text-white shadow-xl"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  aria-hidden="true"
>
  <div class="flex h-16 items-center justify-end border-b border-line-white px-sm">
    <button
      id="menu-close"
      type="button"
      class="inline-flex cursor-pointer items-center justify-center rounded-md p-2 text-navy-100 transition-colors duration-200 hover:text-gold-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
      aria-label="Close navigation menu"
    >
      <X size={24} />
    </button>
  </div>

  <nav class="flex flex-1 flex-col gap-xs overflow-y-auto px-sm py-md" aria-label="Mobile navigation">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'rounded-lg px-3 py-3 font-body text-body font-medium transition-colors duration-200',
            isActive(link.href)
              ? 'bg-hover-white text-gold-400'
              : 'text-navy-100 hover:bg-hover-white hover:text-gold-400',
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="border-t border-line-white p-sm">
    <Button href="/contact" variant="secondary" size="md" class="w-full">
      Schedule Consultation
    </Button>
  </div>
</aside>

<style>
  .drawer {
    transform: translateX(100%);
    visibility: hidden;
    transition:
      transform 300ms ease-out,
      visibility 0s linear 300ms;
  }
  #mobile-menu-root[data-open='true'] .drawer {
    transform: translateX(0);
    visibility: visible;
    transition: transform 300ms ease-out;
  }
  .backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease-out;
  }
  #mobile-menu-root[data-open='true'] .backdrop {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  function initMobileMenu() {
    const root = document.getElementById('mobile-menu-root');
    const toggle = document.getElementById('menu-toggle');
    const closeBtn = document.getElementById('menu-close');
    const backdrop = document.getElementById('menu-backdrop');
    if (!root || !toggle || !closeBtn || !backdrop) return;

    const setOpen = (open: boolean) => {
      root.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      const drawer = document.getElementById('mobile-drawer');
      drawer?.setAttribute('aria-hidden', String(!open));
      document.body.classList.toggle('overflow-hidden', open);
      document.getElementById('menu-icon-burger')?.classList.toggle('hidden', open);
      document.getElementById('menu-icon-close')?.classList.toggle('hidden', !open);
      if (open) {
        document.getElementById('menu-close')?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(root.dataset.open !== 'true'));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    const w = window as unknown as { __mkMenuKeyBound?: boolean };
    if (!w.__mkMenuKeyBound) {
      w.__mkMenuKeyBound = true;
      document.addEventListener('keydown', (e) => {
        const root = document.getElementById('mobile-menu-root');
        if (root?.dataset.open !== 'true') return;

        if (e.key === 'Escape') {
          e.preventDefault();
          document.getElementById('menu-close')?.click();
          return;
        }

        if (e.key !== 'Tab') return;
        const drawer = document.getElementById('mobile-drawer');
        if (!drawer) return;
        const focusables = Array.from(
          drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
        ).filter((el) => el.offsetParent !== null);
        if (focusables.length === 0) return;
        const first = focusables[0]!;
        const last = focusables[focusables.length - 1]!;
        const active = document.activeElement;
        if (!(active instanceof HTMLElement) || !drawer.contains(active)) {
          e.preventDefault();
          first.focus();
        } else if (e.shiftKey && active === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && active === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initMobileMenu);
</script>
