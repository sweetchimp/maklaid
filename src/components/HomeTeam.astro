---
import { fade } from 'astro:transitions';
import Card from './design-system/Card.astro';
import Badge from './design-system/Badge.astro';
import Button from './design-system/Button.astro';
import { team } from '../data/team';

interface Props {}
---

<section id="team-preview" class="py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <div class="mx-auto mb-lg max-w-2xl text-center">
      <h2
        transition:name="home-team"
        transition:animate={fade({ duration: '0.35s' })}
        class="font-heading text-h2 font-bold text-navy-900"
      >
        Meet Our Team
      </h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Advocates who know the law — and listen first.
      </p>
    </div>

    <div class="grid gap-md md:grid-cols-3">
      {
        team.map((member, index) => (
          <Card bordered class:list={['group animate-slide-up', `stagger-${index + 1}`]}>
            <div slot="image" class="relative h-72">
              <a href={`/team/${member.slug}`} class="block h-full" aria-label={`View profile of ${member.name}`}>
                <img
                  src={member.photo}
                  alt={`Portrait of ${member.name}`}
                  width="480"
                  height="600"
                  loading="lazy"
                  class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                />
                <div class="absolute inset-0 flex items-center bg-navy-950/85 p-md opacity-0 transition-opacity duration-300 group-focus-within:opacity-100 group-hover:opacity-100">
                  <p class="font-body text-small leading-relaxed text-white">{member.shortBio}</p>
                </div>
              </a>
            </div>
            <h3 class="font-heading text-h3 font-semibold text-navy-900">{member.name}</h3>
            <p class="font-body text-small text-neutral-500">{member.title}</p>
            <div class="mt-xs flex flex-wrap gap-xs">
              {member.practices.map((practice) => (
                <Badge variant="navy" size="sm">
                  {practice}
                </Badge>
              ))}
            </div>
            <a
              href={`/team/${member.slug}`}
              class="mt-sm font-body text-small font-semibold text-gold-600 underline-offset-4 transition-colors duration-200 hover:text-gold-500 hover:underline"
            >
              View Profile
            </a>
          </Card>
        ))
      }
    </div>

    <div class="mt-lg text-center">
      <Button href="/team" variant="ghost" size="md">View Full Team</Button>
    </div>
  </div>
</section>
