---
import { ChevronDown } from 'lucide-react';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-sm">
  {
    items.map(({ question, answer }) => (
      <details class="group rounded-lg border border-neutral-200 bg-white transition-shadow duration-200 open:shadow-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-md px-md py-sm font-body font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
          {question}
          <ChevronDown
            size={20}
            className="shrink-0 text-gold-600 transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <p class="px-md pb-md pt-xs font-body text-body leading-relaxed text-neutral-500">{answer}</p>
      </details>
    ))
  }
</div>
