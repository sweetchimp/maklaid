---
import Button from './design-system/Button.astro';

interface Props {
  headline?: string;
  subtext?: string;
  label?: string;
  href?: string;
  variant?: 'gold' | 'navy';
}

const {
  headline = 'Ready to protect what matters?',
  subtext = 'Speak with an advocate today — your first consultation is free.',
  label = 'Schedule Consultation',
  href = '/contact',
  variant = 'gold',
} = Astro.props;

const sectionClass = variant === 'gold' ? 'bg-gold-500' : 'bg-navy-900';
const headingClass = variant === 'gold' ? 'text-navy-950' : 'text-white';
const subClass = variant === 'gold' ? 'text-navy-900' : 'text-navy-100';
const buttonVariant = variant === 'gold' ? 'primary' : 'secondary';
---

<section class:list={['py-lg md:py-[5rem]', sectionClass]}>
  <div
    class="mx-auto flex max-w-7xl flex-col items-start gap-md px-sm text-left md:px-lg"
  >
    <div class="w-full">
      <h2 class:list={['font-heading text-h3 font-bold', headingClass]}>
        {headline}
      </h2>
      <p class:list={['mt-2 max-w-3xl font-body text-body leading-relaxed', subClass]}>{subtext}</p>
    </div>
    <Button href={href} variant={buttonVariant} size="lg">
      {label}
    </Button>
  </div>
</section>
