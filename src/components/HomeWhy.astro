---
import { fade } from 'astro:transitions';
import { GraduationCap, HeartHandshake, Trophy, ShieldCheck } from 'lucide-react';

interface Props {}

const benefits = [
  {
    Icon: GraduationCap,
    title: 'Deep Expertise',
    description:
      'Specialist advocates across six core practices, backed by continuous training and sector insight.',
  },
  {
    Icon: HeartHandshake,
    title: 'Client-Focused',
    description:
      'Plain-language advice, transparent fees and a dedicated point of contact on every matter.',
  },
  {
    Icon: Trophy,
    title: 'Proven Results',
    description:
      'Hundreds of resolved disputes, transactions and defenses — judged by outcomes, not hours billed.',
  },
  {
    Icon: ShieldCheck,
    title: 'Trusted Counsel',
    description:
      'Confidentiality and integrity as standard, with a client base that returns and refers.',
  },
];
---

<section id="why-maklaid" class="dot-grid bg-neutral-50 py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <h2
      transition:name="home-why"
      transition:animate={fade({ duration: '0.35s' })}
      class="mb-lg text-center font-heading text-h2 font-bold text-navy-900"
    >
      Why Choose MAKLAID
    </h2>

    <div class="grid grid-cols-1 gap-md sm:grid-cols-2">
      {
        benefits.map(({ Icon, title, description }, i) => (
          <div
            class:list={[
              'flex flex-col items-center gap-md rounded-2xl border border-neutral-200 bg-white/80 p-lg backdrop-blur-sm transition-all duration-300 hover:border-gold-400 hover:shadow-lg animate-slide-up',
              `stagger-${i + 1}`,
            ]}
          >
            <div class="flex items-center justify-center rounded-2xl bg-gold-100 p-md text-gold-700">
              <Icon size={48} stroke-width={1.5} />
            </div>
            <div class="text-center">
              <h3 class="font-heading text-body font-semibold text-navy-900">{title}</h3>
              <p class="mt-xs font-body text-small leading-relaxed text-neutral-500">{description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dot-grid {
    background-image: radial-gradient(rgba(21, 33, 55, 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
  }
</style>
