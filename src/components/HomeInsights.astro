---
import { getCollection } from 'astro:content';
import { fade } from 'astro:transitions';
import { ArrowRight } from 'lucide-react';
import Card from './design-system/Card.astro';
import { team } from '../data/team';

interface Props {}

const PAGE_SIZE = 9;

const posts = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, PAGE_SIZE);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(date);

const readingTime = (body?: string) =>
  Math.max(1, Math.round((body?.trim().split(/\s+/).length ?? 0) / 200));

const authorName = (slug: string) =>
  team.find((member) => member.slug === slug)?.name ?? 'MAKLAID Team';
---

<section id="insights" class="bg-neutral-50 py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <div class="mx-auto mb-lg max-w-2xl text-center">
      <h2
        transition:name="home-insights"
        transition:animate={fade({ duration: '0.35s' })}
        class="font-heading text-h2 font-bold text-navy-900"
      >
        Latest Insights
      </h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Practical commentary on the legal issues shaping business and life.
      </p>
    </div>

    <div class="grid gap-md md:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/insights/${post.id}`}
            class="group h-full rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500"
          >
            <Card variant="interactive" bordered class="h-full">
              <img
                slot="image"
                src={post.data.image}
                alt={post.data.title}
                width="800"
                height="450"
                loading="lazy"
                class="h-44 w-full object-cover"
              />
              <p class="font-body text-small font-medium tracking-wide text-neutral-500 uppercase">
                {formatDate(post.data.pubDate)}
              </p>
              <h3 class="mt-xs font-heading text-body font-semibold text-navy-900">{post.data.title}</h3>
              <p class="font-body text-small leading-relaxed text-neutral-500">{post.data.excerpt}</p>
              <p class="mt-xs font-body text-small font-medium text-navy-600">
                {authorName(post.data.author)} · {readingTime(post.body)} min read
              </p>
              <span class="mt-auto inline-flex items-center gap-1 pt-sm font-body text-small font-semibold text-gold-600 transition-colors duration-200 group-hover:text-gold-500">
                Read More
                <ArrowRight
                  size={16}
                  className="transition-transform duration-200 group-hover:translate-x-0.5"
                />
              </span>
            </Card>
          </a>
        ))
      }
    </div>
  </div>
</section>
