---
import { getCollection } from 'astro:content';
import { fade } from 'astro:transitions';
import Card from './design-system/Card.astro';
import Badge from './design-system/Badge.astro';
import { team } from '../data/team';

interface Props {}

const PAGE_SIZE = 9;

const posts = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, PAGE_SIZE);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { dateStyle: 'long' }).format(date);

const readingTime = (body?: string) =>
  Math.max(1, Math.round((body?.trim().split(/\s+/).length ?? 0) / 200));

const authorName = (slug: string) =>
  team.find((member) => member.slug === slug)?.name ?? 'MAKLAID Team';
---

<section id="insights" class="bg-neutral-50 py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <div class="mx-auto mb-lg max-w-2xl text-center">
      <h2
        transition:name="home-insights"
        transition:animate={fade({ duration: '0.35s' })}
        class="font-heading text-h2 font-bold text-navy-900"
      >
        Latest Insights
      </h2>
      <p class="mt-xs font-body text-body text-neutral-500">
        Practical commentary on the legal issues shaping business and life.
      </p>
    </div>

    <div class="grid gap-md md:grid-cols-2">
      {
        posts.map((post, index) => (
          <a
            href={`/insights/${post.id}`}
            class:list={[
              'group h-full rounded-xl animate-slide-up focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-500',
              `stagger-${index + 1}`,
            ]}
          >
            <Card variant="interactive" bordered class="flex h-full flex-col">
              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-xs">
                  {post.data.tags.map((tag) => (
                    <Badge variant="navy" size="sm">{tag}</Badge>
                  ))}
                </div>
              )}
              <h3 class="mt-sm font-heading text-body font-semibold text-navy-900">{post.data.title}</h3>
              <p class="font-body text-small leading-relaxed text-neutral-500">{post.data.excerpt}</p>
              <p class="mt-sm font-body text-small font-medium tracking-wide text-neutral-400 uppercase">
                {formatDate(post.data.pubDate)}
              </p>
              <p class="mt-xs font-body text-small font-medium text-navy-600">
                By {authorName(post.data.author)} · {readingTime(post.body)} min read
              </p>
              <span class="mt-auto pt-md font-body text-small font-semibold text-gold-600 transition-colors duration-200 group-hover:text-gold-500">
                Read More →
              </span>
            </Card>
          </a>
        ))
      }
    </div>
  </div>
</section>
