---
import Logo from './design-system/Logo.astro';
import CtaSection from './CtaSection.astro';
import { MapPin, Phone, Mail, MessageCircle } from 'lucide-react';
import { footerColumns, legalLinks, contactInfo } from '../lib/theme';

interface Props {}

const year = new Date().getFullYear();

const iconMap = { 'map-pin': MapPin, phone: Phone, mail: Mail, 'message-circle': MessageCircle } as const;

const LinkedInIcon = `
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/>
  </svg>
`;
---

<!-- CTA band -->
<CtaSection />

<footer id="contact" class="bg-navy-950 text-navy-100">
  <!-- Brand row -->
  <div class="mx-auto max-w-7xl px-sm pt-xl md:px-lg">
    <div class="flex max-w-sm flex-col gap-sm">
      <a href="/" class="hover-scale w-fit" aria-label="MAKLAID home">
        <Logo class="h-14 w-auto" />
      </a>
      <p class="font-body text-small leading-relaxed text-navy-300">
        MAKLAID is a full-service law firm delivering trusted counsel and results-driven
        representation for individuals and businesses.
      </p>
      <a
        href="https://www.linkedin.com/company/maklaid"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-xs inline-flex h-9 w-9 items-center justify-center rounded-full border border-line-white text-navy-200 transition-colors duration-200 hover:border-gold-500 hover:text-gold-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
        aria-label="MAKLAID on LinkedIn"
      >
        <Fragment set:html={LinkedInIcon} />
      </a>
    </div>

    <!-- 3-column grid -->
    <div class="mt-lg grid gap-lg pb-xl sm:grid-cols-2 lg:grid-cols-3">
      {
        footerColumns.map((column) => (
          <nav aria-label={`Footer — ${column.heading}`}>
            <h3 class="font-heading text-body font-semibold uppercase tracking-widest text-white">
              {column.heading}
            </h3>
            <ul class="mt-sm flex flex-col gap-xs">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="font-body text-small text-navy-200 transition-colors duration-200 hover:text-gold-400"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div>
        <h3 class="font-heading text-body font-semibold uppercase tracking-widest text-white">
          Contact Info
        </h3>
        <ul class="mt-sm flex flex-col gap-xs">
          {
            contactInfo.map(({ icon, label, href }) => {
              const Icon = iconMap[icon];
              return (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 shrink-0 text-gold-500">
                    <Icon size={18} />
                  </span>
                  {href ? (
                    <a
                      href={href}
                      class="font-body text-small text-navy-200 transition-colors duration-200 hover:text-gold-400"
                    >
                      {label}
                    </a>
                  ) : (
                    <span class="font-body text-small text-navy-200">{label}</span>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-line-white">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-xs px-sm py-md text-center sm:flex-row sm:text-left md:px-lg"
    >
      <p class="font-body text-small text-navy-300">
        &copy; {year} MAKLAID Law Firm. All rights reserved.
      </p>
      <ul class="flex items-center gap-md">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-small text-navy-300 transition-colors duration-200 hover:text-gold-400"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
