---
import { fade } from 'astro:transitions';
import { firmInfo } from '../data/firm';

interface Props {}

const stats = firmInfo.stats;
---

<section id="about" class="bg-neutral-50 py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <div class="grid items-center gap-lg md:grid-cols-2">
      <div class="animate-slide-up stagger-1">
        <h2
          transition:name="home-about"
          transition:animate={fade({ duration: '0.35s' })}
          class="font-heading text-h2 font-bold text-navy-900"
        >
          About MAKLAID
        </h2>
        <p class="mt-md font-body text-body leading-relaxed text-neutral-500">
          MAKLAID ADVOCATES is a dynamic and innovative law firm based in Uganda, East Africa,
          founded in 2024. We pride ourselves on delivering expert legal counsel and
          representation to our clients across the region.
        </p>
        <p class="mt-sm font-body text-body leading-relaxed text-neutral-500">
          From individuals and small businesses to large corporations and organizations,
          we measure ourselves by one standard — outcomes our clients can build on.
        </p>
      </div>

      <div class="grid gap-md sm:grid-cols-3 md:grid-cols-1">
        {
          stats.map(({ value, label }, index) => (
            <div class:list={[
              'flex items-baseline gap-xs rounded-xl border border-neutral-200 bg-white px-md py-sm shadow-sm transition-all duration-300 hover:border-gold-400 hover:shadow-md animate-slide-up md:flex-col md:items-start md:gap-0',
              `stagger-${index + 2}`,
            ]}>
              <span class="font-heading text-h3 font-bold text-navy-900">{value}</span>
              <span class="font-body text-small font-medium tracking-wide text-neutral-500 uppercase">
                {label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
