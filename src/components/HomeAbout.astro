---
import { fade } from 'astro:transitions';

interface Props {}

const stats = [
  { value: '25+', label: 'Years in Business' },
  { value: '500+', label: 'Cases Won' },
  { value: '98%', label: 'Happy Clients' },
];
---

<section id="about" class="bg-neutral-50 py-lg md:py-[5rem]">
  <div class="mx-auto max-w-7xl px-sm md:px-lg">
    <div class="grid items-center gap-lg md:grid-cols-2">
      <div>
        <h2
          transition:name="home-about"
          transition:animate={fade({ duration: '0.35s' })}
          class="font-heading text-h2 font-bold text-navy-900"
        >
          About MAKLAID
        </h2>
        <p class="mt-md font-body text-body leading-relaxed text-neutral-500">
          MAKLAID is a full-service Kenyan law firm built on a simple conviction: excellent legal
          counsel should be rigorous, responsive and human. Our advocates combine deep technical
          mastery with the practical judgment that only years in the field deliver.
        </p>
        <p class="mt-sm font-body text-body leading-relaxed text-neutral-500">
          From multinational corporations to families navigating life's hardest moments, we
          measure ourselves by one standard — outcomes our clients can build on.
        </p>
      </div>

      <div class="grid gap-md sm:grid-cols-3 md:grid-cols-1">
        {
          stats.map(({ value, label }) => (
            <div class="flex items-baseline gap-xs rounded-xl border border-neutral-200 bg-white px-md py-sm shadow-sm md:flex-col md:items-start md:gap-0">
              <span class="font-heading text-h3 font-bold text-navy-900">{value}</span>
              <span class="font-body text-small font-medium tracking-wide text-neutral-500 uppercase">
                {label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
