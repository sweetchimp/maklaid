---
/**
 * Brand watermark rendered on every page via BaseLayout.
 * Centered in the viewport at very low opacity; pointer-events
 * are disabled so it never interferes with content or links.
 */
import Logo from './Logo.astro';
---

<div
  class="pointer-events-none fixed inset-0 z-40 flex items-center justify-center opacity-[0.03] select-none mix-blend-multiply"
  aria-hidden="true"
>
  <Logo class="h-auto w-80 md:w-[500px]" alt="" />
</div>
