---
/**
 * Brand watermark rendered on every page via BaseLayout.
 * Uses the official logo JPG as-is at low opacity, fixed to the
 * lower-right corner; pointer-events are disabled so it never
 * interferes with content or links.
 */
import Logo from './Logo.astro';
---

<div
  class="pointer-events-none fixed right-4 bottom-4 z-40 hidden opacity-[0.05] select-none sm:block md:right-8 md:bottom-8"
  aria-hidden="true"
>
  <Logo class="h-auto w-52 md:w-64 xl:w-72" alt="" />
</div>
