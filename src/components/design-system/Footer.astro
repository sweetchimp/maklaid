---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { MapPin, Phone, Mail } from 'lucide-react';

interface Props {}

const year = new Date().getFullYear();

const footerLinks = [
  { label: 'About the Firm', href: '/about' },
  { label: 'Practice Areas', href: '/services' },
  { label: 'Our Attorneys', href: '/team' },
  { label: 'Client Insights', href: '/insights' },
  { label: 'Careers', href: '/contact' },
];

const contactItems = [
  { icon: MapPin, label: '2nd Floor, Africourts, Buganda Road, Kampala', href: undefined },
  { icon: Phone, label: '+256 757 401962', href: 'tel:+256757401962' },
  { icon: Mail, label: 'info@maklaidadvocates.com', href: 'mailto:info@maklaidadvocates.com' },
];
---

<footer id="contact" class="bg-navy-950 text-navy-100">
  <div class="mx-auto grid max-w-7xl gap-lg px-sm py-xl sm:grid-cols-2 md:px-lg lg:grid-cols-3">
    <!-- Column 1 — Brand -->
    <div class="flex flex-col gap-sm">
      <a href="/" class="hover-scale w-fit" aria-label="MAKLAID home">
        <Logo class="h-14 w-auto" />
      </a>
      <p class="max-w-xs font-body text-small leading-relaxed text-navy-300">
        MAKLAID is a full-service law firm delivering trusted counsel and results-driven
        representation for individuals and businesses.
      </p>
    </div>

    <!-- Column 2 — Quick links -->
    <nav aria-label="Footer navigation">
      <h3 class="font-heading text-body font-semibold text-white uppercase tracking-widest">
        Quick Links
      </h3>
      <ul class="mt-sm flex flex-col gap-xs">
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-small text-navy-200 transition-colors duration-200 hover:text-gold-400"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Column 3 — Contact + CTA -->
    <div>
      <h3 class="font-heading text-body font-semibold text-white uppercase tracking-widest">
        Get in Touch
      </h3>
      <ul class="mt-sm flex flex-col gap-xs">
        {
          contactItems.map(({ icon: Icon, label, href }) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 shrink-0 text-gold-500">
                <Icon size={18} />
              </span>
              {href ? (
                <a
                  href={href}
                  class="font-body text-small text-navy-200 transition-colors duration-200 hover:text-gold-400"
                >
                  {label}
                </a>
              ) : (
                <span class="font-body text-small text-navy-200">{label}</span>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-md">
        <Button href="mailto:info@maklaidadvocates.com" variant="secondary" size="md">
          Schedule a Consultation
        </Button>
      </div>
    </div>
  </div>

  <div class="border-t border-line-white">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-xs px-sm py-md text-center sm:flex-row sm:text-left md:px-lg"
    >
      <p class="font-body text-small text-navy-300">
        &copy; {year} MAKLAID Law Firm. All rights reserved.
      </p>
      <p class="font-body text-small text-navy-400">
        Advocates &middot; Commissioners for Oaths &middot; Notaries Public
      </p>
    </div>
  </div>
</footer>
